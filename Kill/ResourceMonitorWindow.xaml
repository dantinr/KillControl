<Window x:Class="Kill.ResourceMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Kill.Controls"
        Title="Kill Control - 资源监控" Width="1180" Height="760" MinWidth="1020" MinHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="78" />
            <RowDefinition Height="132" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="资源监控" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="系统资源采样与本地历史记录" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="SQLite 数据库" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" HorizontalAlignment="Right" />
                    <TextBlock x:Name="DatabasePathText" FontSize="12" Margin="0,3,0,0"
                               MaxWidth="560" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="30000" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="监控项目" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,7" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="CpuCheckBox" Content="CPU" IsChecked="True" Margin="0,0,18,0"
                                  Checked="MetricSelection_Changed" Unchecked="MetricSelection_Changed" />
                        <CheckBox x:Name="MemoryCheckBox" Content="内存" IsChecked="True" Margin="0,0,18,0"
                                  Checked="MetricSelection_Changed" Unchecked="MetricSelection_Changed" />
                        <CheckBox x:Name="DiskCheckBox" Content="硬盘" IsChecked="True" Margin="0,0,18,0"
                                  Checked="MetricSelection_Changed" Unchecked="MetricSelection_Changed" />
                        <CheckBox x:Name="NetworkCheckBox" Content="网络" IsChecked="True"
                                  Checked="MetricSelection_Changed" Unchecked="MetricSelection_Changed" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Height="42" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="采样间隔" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                    <ComboBox x:Name="IntervalComboBox" Width="126" SelectedIndex="0">
                        <ComboBoxItem Content="5 秒" Tag="5" />
                        <ComboBoxItem Content="30 秒" Tag="30" />
                        <ComboBoxItem Content="1 分钟" Tag="60" />
                        <ComboBoxItem Content="3 分钟" Tag="180" />
                        <ComboBoxItem Content="5 分钟" Tag="300" />
                    </ComboBox>
                </StackPanel>

                <Border Grid.Column="3" Width="1" Height="42" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="监控时长" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                    <ComboBox x:Name="DurationComboBox" Width="126" SelectedIndex="0">
                        <ComboBoxItem Content="不限时" Tag="0" />
                        <ComboBoxItem Content="30 分钟" Tag="30" />
                        <ComboBoxItem Content="60 分钟" Tag="60" />
                    </ComboBox>
                </StackPanel>

                <Button x:Name="StopButton" Grid.Column="6" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,9,0" IsEnabled="False" Click="StopButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                        <TextBlock Text="停止" />
                    </StackPanel>
                </Button>
                <Button x:Name="StartButton" Grid.Column="7" Style="{StaticResource SafeButton}" Click="StartButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                        <TextBlock Text="开始监控" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="22,14,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CpuCard" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CPU" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock x:Name="CpuValueText" Text="等待采样" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,4" />
                        <TextBlock Text="系统总使用率" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="5" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="MemoryCard" Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="内存" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock x:Name="MemoryValueText" Text="等待采样" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,4" />
                        <TextBlock x:Name="MemoryDetailText" Text="系统物理内存" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="5" Background="#E5F3F1">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource TealBrush}"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="DiskCard" Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="硬盘 I/O" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock x:Name="DiskValueText" Text="等待采样" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,4" />
                        <TextBlock x:Name="DiskDetailText" Text="读取 -  ·  写入 -" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="5" Background="{StaticResource WarningSoftBrush}">
                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WarningBrush}"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="NetworkCard" Grid.Column="6" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="网络" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock x:Name="NetworkValueText" Text="等待采样" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,4" />
                        <TextBlock x:Name="NetworkDetailText" Text="发送 -" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="5" Background="#E8F0FA">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" Foreground="#2A67A5"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="22,0,22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="资源分析" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="RecordCountText" Text="0 条" Margin="10,2,0,0"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
                <Button x:Name="OpenDataButton" Grid.Column="1" Style="{StaticResource QuietButton}"
                        Margin="0,0,5,0" Padding="10,6" Click="OpenDataButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="打开数据目录" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource QuietButton}"
                        Padding="10,6" Click="ClearButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="清空历史数据" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <TabControl x:Name="AnalysisTabControl" Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource BorderBrush}"
                        Padding="0" SelectedIndex="0">
                <TabItem Header="趋势统计（120 样本）">
                    <Grid Margin="0,9,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU 使用率" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CpuTrendValueText" Grid.Column="1" Text="-" HorizontalAlignment="Right"
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                                <controls:ResourceTrendChart x:Name="CpuTrendChart" Grid.Row="1" Margin="0,7,0,0"
                                                             PrimaryStroke="#C93C3C" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="内存使用率" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MemoryTrendValueText" Grid.Column="1" Text="-" HorizontalAlignment="Right"
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                                <controls:ResourceTrendChart x:Name="MemoryTrendChart" Grid.Row="1" Margin="0,7,0,0"
                                                             PrimaryStroke="#147D73" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="硬盘吞吐" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="  读取" Foreground="#A15C00" FontSize="11" />
                                        <TextBlock Text="  写入" Foreground="{StaticResource TealBrush}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock x:Name="DiskTrendValueText" Grid.Column="1" Text="-" HorizontalAlignment="Right"
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                                <controls:ResourceTrendChart x:Name="DiskTrendChart" Grid.Row="1" Margin="0,7,0,0"
                                                             PrimaryStroke="#A15C00" SecondaryStroke="#147D73" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="网络吞吐" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="  接收" Foreground="#2A67A5" FontSize="11" />
                                        <TextBlock Text="  发送" Foreground="{StaticResource TealBrush}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock x:Name="NetworkTrendValueText" Grid.Column="1" Text="-" HorizontalAlignment="Right"
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>
                                <controls:ResourceTrendChart x:Name="NetworkTrendChart" Grid.Row="1" Margin="0,7,0,0"
                                                             PrimaryStroke="#2A67A5" SecondaryStroke="#147D73" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="历史数据">
                    <Border Margin="0,9,0,0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <DataGrid x:Name="SamplesGrid" ItemsSource="{Binding Samples}" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Background="White" RowHeaderWidth="0"
                                  AlternatingRowBackground="#FAFBFC" HorizontalGridLinesBrush="#EEF0F2"
                                  SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding CapturedAtLabel}" Width="125" />
                                <DataGridTextColumn Header="CPU" Binding="{Binding CpuLabel}" Width="72" />
                                <DataGridTextColumn Header="内存" Binding="{Binding MemoryLabel}" Width="90" />
                                <DataGridTextColumn Header="硬盘活动" Binding="{Binding DiskActiveLabel}" Width="82" />
                                <DataGridTextColumn Header="硬盘读取" Binding="{Binding DiskReadLabel}" Width="105" />
                                <DataGridTextColumn Header="硬盘写入" Binding="{Binding DiskWriteLabel}" Width="105" />
                                <DataGridTextColumn Header="网络接收" Binding="{Binding NetworkReceivedLabel}" Width="105" />
                                <DataGridTextColumn Header="网络发送" Binding="{Binding NetworkSentLabel}" Width="105" />
                                <DataGridTextColumn Header="会话" Binding="{Binding SessionId}" Width="*" MinWidth="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem Header="进程 Top 10">
                    <Grid Margin="0,9,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="最近一次进程采样" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProcessCountText" Text="尚无采样" Margin="10,1,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="排序" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <ComboBox x:Name="ProcessRankingComboBox" Width="128" SelectedIndex="0"
                                          SelectionChanged="ProcessRankingComboBox_SelectionChanged">
                                    <ComboBoxItem Content="CPU 使用率" Tag="Cpu" />
                                    <ComboBoxItem Content="工作集" Tag="Memory" />
                                    <ComboBoxItem Content="I/O 吞吐" Tag="Io" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <DataGrid x:Name="TopProcessesGrid" ItemsSource="{Binding TopProcesses}" IsReadOnly="True"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          BorderThickness="0" Background="White" RowHeaderWidth="0"
                                          AlternatingRowBackground="#FAFBFC" HorizontalGridLinesBrush="#EEF0F2"
                                          SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44" />
                                        <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="*" MinWidth="190" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="72" />
                                        <DataGridTextColumn Header="CPU" Binding="{Binding CpuLabel}" Width="88" />
                                        <DataGridTextColumn Header="工作集" Binding="{Binding MemoryLabel}" Width="105" />
                                        <DataGridTextColumn Header="读取 I/O" Binding="{Binding IoReadLabel}" Width="105" />
                                        <DataGridTextColumn Header="写入 I/O" Binding="{Binding IoWriteLabel}" Width="105" />
                                        <DataGridTextColumn Header="其他 I/O" Binding="{Binding IoOtherLabel}" Width="105" />
                                        <DataGridTextColumn Header="I/O 总计" Binding="{Binding IoTotalLabel}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TopProcessesEmptyText" Text="暂无进程采样" FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="4" Background="#F0F2F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource TealBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <ProgressBar x:Name="BusyProgress" Grid.Column="1" Width="150" Height="4" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
