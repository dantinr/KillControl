<Window x:Class="Kill.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="风险确认" Width="540" SizeToContent="Height" MaxHeight="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="6" Background="{StaticResource WarningSoftBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="19"
                           Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText" Margin="0,5,0,0" FontSize="14"
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="14" Background="{StaticResource WarningSoftBrush}"
                BorderBrush="#F1D7A8" BorderThickness="1" CornerRadius="6">
            <TextBlock x:Name="WarningText" Foreground="#795C2E" TextWrapping="Wrap" LineHeight="21" />
        </Border>

        <StackPanel x:Name="TypingPanel" Grid.Row="2" Margin="0,18,0,0" Visibility="Collapsed">
            <TextBlock x:Name="TypingPrompt" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            <TextBox x:Name="ConfirmationInput" Margin="0,8,0,0" TextChanged="ConfirmationInput_TextChanged" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="取消" Margin="0,0,9,0" IsCancel="True" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
