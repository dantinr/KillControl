<Window x:Class="Kill.ServiceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kill - 服务管理" Width="1180" Height="760" MinWidth="1020" MinHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="服务管理" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="识别软件自带的后台服务，并控制它们的启动行为"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="#F1D7A8"
                            BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="修改服务会影响软件功能" Foreground="#795C2E" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            ToolTip="刷新服务列表" Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FAFBFC">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,18,18,10">
                        <TextBox x:Name="SearchBox" Height="40" Padding="36,7,10,7"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="13,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchHint" Text="搜索服务、发布者或宿主路径" Margin="36,0,0,0"
                                   Foreground="#8A919C" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="18,0,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="172" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ServiceCountText" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}" Text="正在读取…" />
                        <ComboBox x:Name="ServiceFilter" Grid.Column="1" SelectedIndex="0"
                                  SelectionChanged="ServiceFilter_SelectionChanged">
                            <ComboBoxItem Content="运行中的第三方服务" Tag="RunningThirdParty" />
                            <ComboBoxItem Content="全部第三方服务" Tag="AllThirdParty" />
                            <ComboBoxItem Content="黑名单" Tag="Blacklisted" />
                            <ComboBoxItem Content="全部服务" Tag="All" />
                        </ComboBox>
                    </Grid>

                    <ListBox x:Name="ServicesList" Grid.Row="2" Margin="10,0,8,10"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ServicesList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,2,3" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                                    CornerRadius="5" Padding="10,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemChrome" Property="Background" Value="#EEF1F4" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="5" Background="#E5E9ED"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="Bold"
                                                   Foreground="#414852" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name}" /><Run Text="  ·  " /><Run Text="{Binding CompanyName}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource TealBrush}"
                                                   FontSize="12" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding BlacklistLabel}" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Column="2" Background="White">
                <Grid x:Name="EmptyState">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350">
                        <Border Width="56" Height="56" CornerRadius="6" Background="#EEF1F4">
                            <TextBlock Text="&#xE83B;" FontFamily="Segoe Fluent Icons" FontSize="25"
                                       Foreground="#69707D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="选择一个服务" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,5" />
                        <TextBlock Text="查看启动方式、运行账户和宿主文件。系统保护服务只能查看。"
                                   Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="DetailPanel" Visibility="Collapsed" Margin="32,25,32,22"
                      DataContext="{Binding SelectedItem, ElementName=ServicesList}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="6" Background="#E5E9ED" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="Bold"
                                       Foreground="#414852" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CompanyName}" Margin="0,4,0,0" FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,16">
                        <Border Style="{StaticResource PillText}" Margin="0,0,7,0"><TextBlock Text="{Binding StateLabel}" FontSize="12" /></Border>
                        <Border Style="{StaticResource PillText}" Margin="0,0,7,0"><TextBlock Text="{Binding StartModeLabel}" FontSize="12" /></Border>
                        <Border Style="{StaticResource PillText}" Margin="0,0,7,0"><TextBlock Text="{Binding ClassificationLabel}" FontSize="12" /></Border>
                        <Border x:Name="BlacklistBadge" Style="{StaticResource PillText}" Background="{StaticResource AccentSoftBrush}" Visibility="Collapsed">
                            <TextBlock Text="已列入黑名单" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="服务名称" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="进程 ID" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProcessIdLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="运行账户" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StartAccount}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="服务类型" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ServiceType}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Text="服务命令" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ImageCommand}" TextWrapping="Wrap" Margin="0,9,0,8" />
                            <TextBlock Grid.Row="5" Text="宿主程序" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ExecutablePath}" TextWrapping="Wrap" Margin="0,9,0,8" />
                            <TextBlock Grid.Row="6" Text="服务模块" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ServiceDllPath}" TextWrapping="Wrap" Margin="0,9,0,8" />
                            <TextBlock Grid.Row="7" Text="说明" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Top" Margin="0,9,0,0" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,9,0,8" />
                        </Grid>
                    </ScrollViewer>

                    <Border x:Name="ProtectionNotice" Grid.Row="3" Background="#F1F3F5" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,13,0,13" Visibility="Collapsed">
                        <TextBlock Text="该服务涉及 Windows、Microsoft 组件、驱动程序或无法确认的宿主，已启用系统保护。Kill 不允许修改或删除它。"
                                   Foreground="#555D68" TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LocateButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Padding="12,8" Click="LocateButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="定位宿主" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DisableButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Padding="12,8" Click="DisableButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="禁止运行" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BlacklistButton" Grid.Column="3" Style="{StaticResource WarningButton}"
                                Margin="0,0,8,0" Padding="12,8" Click="BlacklistButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock x:Name="BlacklistButtonText" Text="列入黑名单" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton" Grid.Column="4" Style="{StaticResource PrimaryButton}"
                                Padding="12,8" Click="DeleteButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="删除服务" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F0F2F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource TealBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <ProgressBar x:Name="BusyProgress" Grid.Column="1" Width="150" Height="4" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
