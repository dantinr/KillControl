<Window x:Class="Kill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kill Control" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="6" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="K" Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kill Control" FontSize="22" FontWeight="Bold" />
                            <TextBlock x:Name="VersionText" Margin="9,6,0,0" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="应用卸载与残留隔离" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ResourceMonitorButton" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Padding="13,7" Click="ResourceMonitorButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="资源监控" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ServicesButton" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Padding="13,7" Click="ServicesButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE83B;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="服务管理" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryButton" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Padding="13,7" Click="HistoryButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="隔离记录" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            ToolTip="刷新应用列表" Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FAFBFC">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,18,18,10">
                        <TextBox x:Name="SearchBox" Height="40" Padding="36,7,10,7"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="15"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="13,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchHint" Text="搜索名称、发布者或版本" Margin="36,0,0,0"
                                   Foreground="#8A919C" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="18,0,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AppCountText" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}" Text="正在读取…" />
                        <ComboBox x:Name="KindFilter" Grid.Column="1" SelectedIndex="0"
                                  SelectionChanged="KindFilter_SelectionChanged">
                            <ComboBoxItem Content="全部类型" Tag="All" />
                            <ComboBoxItem Content="桌面应用" Tag="Desktop" />
                            <ComboBoxItem Content="商店应用" Tag="Store" />
                        </ComboBox>
                    </Grid>

                    <ListBox x:Name="ApplicationsList" Grid.Row="2" Margin="10,0,8,10"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ApplicationsList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,2,3" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                                    CornerRadius="5" Padding="10,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemChrome" Property="Background" Value="#EEF1F4" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="5" Background="#E5E9ED"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold"
                                                   Foreground="#414852" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding PublisherLabel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding VersionLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Column="2" Background="White">
                <Grid x:Name="EmptyState">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                        <Border Width="56" Height="56" CornerRadius="6" Background="#EEF1F4">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons" FontSize="25"
                                       Foreground="#69707D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="选择一个应用" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,5" />
                        <TextBlock Text="查看安装信息、启动官方卸载，或检查可明确归属的残留。"
                                   Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="DetailPanel" Visibility="Collapsed" Margin="34,28,34,26"
                      DataContext="{Binding SelectedItem, ElementName=ApplicationsList}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" CornerRadius="6" Background="#E5E9ED" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="Bold"
                                       Foreground="#414852" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PublisherLabel}" Margin="0,4,0,0" FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,22">
                        <Border Style="{StaticResource PillText}" Margin="0,0,7,0"><TextBlock Text="{Binding KindLabel}" FontSize="12" /></Border>
                        <Border Style="{StaticResource PillText}" Margin="0,0,7,0"><TextBlock Text="{Binding ScopeLabel}" FontSize="12" /></Border>
                        <Border Style="{StaticResource PillText}"><TextBlock Text="{Binding VersionLabel}" FontSize="12" /></Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="占用空间" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="安装日期" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InstallDateValue" Text="{Binding InstallDate}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="安装范围" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ScopeLabel}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="安装位置" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Top" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstallLocation}" VerticalAlignment="Top"
                                   Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#414852" />
                    </Grid>

                    <Border Grid.Row="3" Background="{StaticResource WarningSoftBrush}" BorderBrush="#F1D7A8"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,26,0,18" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="17"
                                       Foreground="{StaticResource WarningBrush}" Margin="1,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="安全优先模式" FontWeight="SemiBold" Foreground="#6D470F" />
                                <TextBlock Text="Kill 会先运行应用提供的卸载器。残留只在扫描后逐项展示，清理前会备份并移入隔离区。"
                                           Margin="0,4,0,0" Foreground="#795C2E" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CannotUninstallText" Text="此项目没有提供卸载入口"
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="ScanButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE773;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                                <TextBlock Text="扫描残留" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UninstallButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                Click="UninstallButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                                <TextBlock Text="运行官方卸载" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F0F2F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource TealBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <ProgressBar x:Name="BusyProgress" Grid.Column="1" Width="150" Height="4" IsIndeterminate="True"
                             Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
