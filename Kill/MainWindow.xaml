<Window x:Class="Kill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kill Control" Width="1440" Height="960" MinWidth="1280" MinHeight="880"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#F5F6F8" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition Height="50" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#202733" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" Width="38" Height="38" CornerRadius="8"><TextBlock Text="K" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Kill Control" Foreground="White" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="VersionText" Foreground="#BAC2CE" Margin="10,7,0,0" FontSize="11" /></StackPanel>
                        <TextBlock Text="应用与服务管理 · 资源与行为监控" Foreground="#BAC2CE" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="MonitoringStatus" Grid.Column="1" Text="监控未开始" Foreground="#D6DCE5" VerticalAlignment="Center" Margin="20,0" FontSize="12" />
                <Button x:Name="StopMonitoringButton" Grid.Column="2" Content="停止全部监控" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" IsEnabled="False" Click="StopMonitoring_Click" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="18,0">
                <RadioButton x:Name="ApplicationsTab" Content="应用管理" Tag="Applications" Style="{StaticResource NavigationButton}" Checked="Navigation_Checked" GroupName="Workspace" />
                <RadioButton x:Name="ServicesTab" Content="服务管理" Tag="Services" Style="{StaticResource NavigationButton}" Checked="Navigation_Checked" GroupName="Workspace" />
                <RadioButton x:Name="ResourcesTab" Content="资源监控" Tag="Resources" Style="{StaticResource NavigationButton}" Checked="Navigation_Checked" GroupName="Workspace" />
                <RadioButton x:Name="BehaviorTab" Content="行为监控" Tag="Behavior" Style="{StaticResource NavigationButton}" Checked="Navigation_Checked" GroupName="Workspace" />
                <RadioButton x:Name="HistoryTab" Content="隔离记录" Tag="History" Style="{StaticResource NavigationButton}" Checked="Navigation_Checked" GroupName="Workspace" />
                <Button x:Name="AboutButton" Content="关于" Style="{StaticResource QuietButton}"
                        FontSize="14" Padding="24,14" ToolTip="关于 Kill Control" Click="About_Click" />
            </StackPanel>
        </Border>
        <Grid x:Name="Workspace" Grid.Row="2" />
    </Grid>
</Window>
