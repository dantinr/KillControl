<Window x:Class="Kill.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="隔离记录 - Kill" Width="820" Height="540" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,20">
            <StackPanel>
                <TextBlock Text="隔离记录" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="隔离记录可以恢复；直接清理记录仅用于审计，无法恢复。恢复时不会覆盖原位置的现有内容。"
                           Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="22,18">
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="48"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                      Background="White" AlternatingRowBackground="#FAFBFC"
                      SelectionChanged="HistoryGrid_SelectionChanged">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F2F4" />
                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="9,6" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="应用" Binding="{Binding ApplicationName}" Width="*" />
                    <DataGridTextColumn Header="时间" Binding="{Binding CreatedLabel}" Width="170" />
                    <DataGridTextColumn Header="项目" Binding="{Binding ItemCountLabel}" Width="90" />
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="28"
                           Foreground="#8A919C" HorizontalAlignment="Center" />
                <TextBlock Text="还没有隔离记录" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="22,14" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button Style="{StaticResource SecondaryButton}" Click="OpenFolderButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                        <TextBlock Text="打开隔离目录" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="关闭" Margin="0,0,9,0" IsCancel="True" />
                    <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="恢复所选记录"
                            Click="RestoreButton_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
