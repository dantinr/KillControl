<Window x:Class="ProcessSentinel.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 · Kill Control" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        Background="#F4F7FB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
      <Border Background="{StaticResource Accent}" Width="54" Height="54" CornerRadius="14" Margin="0,0,14,0"><TextBlock Text="◎" FontSize="38" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Kill Control · 行为监控" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
      <StackPanel>
        <TextBlock Text="查看程序的文件、网络、注册表、子进程及模块活动，支持同时监控多个程序及其完整进程树。" TextWrapping="Wrap" LineHeight="22"/>
        <TextBlock Text="项目地址" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <TextBlock><Hyperlink NavigateUri="https://github.com/dantinr/processSentinel" RequestNavigate="Project_RequestNavigate">github.com/dantinr/processSentinel</Hyperlink></TextBlock>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,18"/>
        <TextBlock Text="行为线索需要结合程序用途判断。风险提示用于辅助复核，不代表已确认恶意。日志保存在本机，不会自动上传。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20"/>
      </StackPanel>
    </Border>
    <Button Grid.Row="2" Content="关闭" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="82" Margin="0,20,0,0" Click="Close_Click"/>
  </Grid>
</Window>
