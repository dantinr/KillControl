<UserControl x:Class="ProcessSentinel.App.BehaviorMonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:ProcessSentinel.Core;assembly=ProcessSentinel.Core"
        Background="#F5F6F8">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <ContextMenu x:Key="ProcessContextMenu" Opened="ProcessContextMenu_Opened">
      <MenuItem Header="添加监控" Click="AddProcessMonitor_Click"/>
    </ContextMenu>
      </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="0"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
    <TextBlock x:Name="RunBadge" Grid.Row="0" Text="●  等待选择目标" Foreground="#69707D" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0" Panel.ZIndex="1" />
    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0">
      <Menu x:Name="MainMenu" Background="White" VerticalAlignment="Center" AutomationProperties.Name="菜单栏">
        <Menu.ItemContainerStyle><Style TargetType="MenuItem"><Setter Property="Padding" Value="12,5"/></Style></Menu.ItemContainerStyle>
        <MenuItem Header="工具(_T)">
          <MenuItem x:Name="SettingsMenuItem" Header="设置(_S)…" ToolTip="设置默认监控范围和风险筛选" Click="Settings_Click"/>
        </MenuItem>
        <MenuItem Header="帮助(_H)">
          <MenuItem Header="使用说明(_U)" Click="Help_Click"/>
          <Separator/>
          <MenuItem Header="关于(_A)…" ToolTip="查看程序版本和项目信息" Click="About_Click"/>
        </MenuItem>
      </Menu>
    </Border>
    <Grid Grid.Row="2" Margin="20,16,20,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><TextBlock Text="选择监控目标" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="RefreshButton" Content="刷新" HorizontalAlignment="Right" Padding="11,6" Click="Refresh_Click"/></Grid>
          <TextBox x:Name="ProcessSearch" Grid.Row="1" Margin="0,14,0,8" Style="{StaticResource SearchBox}" Tag="搜索进程名称、PID 或路径" ToolTip="按进程名、PID 或路径搜索" TextChanged="ProcessSearch_Changed"/>
          <TextBlock x:Name="ProcessCount" Grid.Row="2" Text="正在读取进程…" Style="{StaticResource Caption}" Margin="0,0,0,9"/>
          <ListBox x:Name="ProcessList" Grid.Row="3" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" SelectionChanged="ProcessList_SelectionChanged">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProcessItem_PreviewMouseRightButtonDown"/>
                <Setter Property="ContextMenu" Value="{StaticResource ProcessContextMenu}"/>
                <Setter Property="Padding" Value="9,9"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id, StringFormat=PID {0}}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="4" Margin="0,14,0,0"><Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/><Button x:Name="LaunchButton" Content="＋  选择 .exe 并启动监控" Click="Launch_Click"/><TextBlock Text="开始时只提升采集器的权限。&#10;目标程序使用当前界面权限。" Style="{StaticResource Caption}" LineHeight="19" Margin="0,4,0,0"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="105"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="16,10">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="2" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="查看程序" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="SessionPicker" Grid.Column="1" MinWidth="180" DisplayMemberPath="Label" SelectionChanged="SessionPicker_SelectionChanged" ToolTip="切换查看不会停止其他程序的监控"/>
              <TextBlock x:Name="SessionCount" Grid.Column="2" Text="监控中 0 / 4 · 会话 0" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0"/>
              <Button x:Name="RemoveSessionButton" Grid.Column="3" Content="移除记录" ToolTip="移除已停止的会话视图，磁盘日志仍保留" IsEnabled="False" Click="RemoveSession_Click"/>
              <Button x:Name="StopAllButton" Grid.Column="4" Content="全部停止" IsEnabled="False" Margin="9,0,0,0" Click="StopAll_Click"/>
            </Grid>
            <StackPanel Grid.Row="1"><TextBlock x:Name="TargetTitle" Text="让程序的行为变得可见" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="TargetPath" Text="选择进程后添加监控，可同时监控多个程序。" Foreground="#64748B" Margin="0,4,18,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="TargetScope" Text="选中子进程时，自动纳入所属程序的父进程、兄弟及子孙进程。" Style="{StaticResource Caption}" Margin="0,4,18,0" TextWrapping="Wrap"/><CheckBox x:Name="IncludeChildren" Content="自动监控所属程序的完整进程树" ToolTip="默认包含相关父进程、兄弟和全部子孙进程；取消勾选后仅监控所选 PID。向上追溯止于 Explorer、终端或系统公共宿主。" IsChecked="True" Checked="ScopeOption_Changed" Unchecked="ScopeOption_Changed" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartButton" Content="添加监控" ToolTip="监控左侧选中的进程，保留其他正在监控的程序" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" IsEnabled="False" Click="Start_Click"/><Button x:Name="StopButton" Content="停止当前" Margin="9,0,0,0" IsEnabled="False" Click="Stop_Click"/></StackPanel>
          </Grid>
        </Border>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,12">
          <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,10,0"><StackPanel><TextBlock Text="捕获事件" Style="{StaticResource Caption}"/><TextBlock x:Name="TotalText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ProcessStat" Text="0 个存活目标进程" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,10,0"><StackPanel><TextBlock Text="网络传输" Style="{StaticResource Caption}"/><TextBlock x:Name="TrafficText" Text="0 B" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="TrafficDetail" Text="↑ 0 B   ↓ 0 B" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="14,9" Margin="0,0,10,0"><StackPanel><TextBlock Text="文件 / 注册表事件" Style="{StaticResource Caption}"/><TextBlock x:Name="FileText" Text="0 / 0" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="记录操作和目标路径" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
          <Button Padding="14,9" HorizontalContentAlignment="Stretch" ToolTip="查看本会话独立保留的全部复核记录" Click="ShowReview_Click">
            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="ReviewCard" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ReviewCard" Property="Background" Value="#FFFBEB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            <StackPanel><TextBlock Text="需要复核的事件" Style="{StaticResource Caption}"/><TextBlock x:Name="AlertText" Text="0" FontSize="25" Foreground="#B45309" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="点击查看独立复核面板" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
          </Button>
        </UniformGrid>
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <TabControl x:Name="MonitorTabs" BorderThickness="0" Background="Transparent" Padding="0" SelectionChanged="MonitorTabs_SelectionChanged">
            <TabItem Header="行为记录">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="KindFilter" Width="105" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="全部行为"/><ComboBoxItem Content="文件"/><ComboBoxItem Content="网络"/><ComboBoxItem Content="注册表"/><ComboBoxItem Content="进程"/><ComboBoxItem Content="模块"/></ComboBox>
              <CheckBox x:Name="RiskOnly" Grid.Column="1" Content="只看风险提示" Margin="14,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
              <TextBox x:Name="EventSearch" Grid.Column="2" MinWidth="100" Margin="0,0,12,0" Style="{StaticResource SearchBox}" Tag="搜索路径、IP、进程或原因" ToolTip="搜索路径、IP、进程名、操作或原因" TextChanged="EventSearch_Changed"/>
              <Button x:Name="ExportButton" Grid.Column="3" Content="导出日志" Padding="12,8" IsEnabled="False" Click="Export_Click"/>
            </Grid>
            <DataGrid x:Name="EventGrid" Grid.Row="1" SelectionChanged="EventGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="112"/>
                <DataGridTextColumn Header="进程 / PID" Binding="{Binding ProcessText}" Width="164" ElementStyle="{StaticResource GridText}"/>
                <DataGridTextColumn Header="类别" Binding="{Binding KindText}" Width="65"/>
                <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="92"/>
                <DataGridTextColumn Header="出网流量" Binding="{Binding OutboundTrafficText}" SortMemberPath="OutboundBytes" Width="100">
                  <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="ToolTip" Value="本条网络事件发送到公网的字节数；接收、连接及本机/局域网通信为 0 B，非网络事件为 —。各进程累计值见“监控进程”。"/></Style></DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*" MinWidth="120" ElementStyle="{StaticResource GridText}"/>
                <DataGridTemplateColumn Header="提示" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="4" Padding="5,4" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F1F5F9"/><Style.Triggers><DataTrigger Binding="{Binding Risk}" Value="{x:Static core:RiskLevel.Attention}"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger><DataTrigger Binding="{Binding Risk}" Value="{x:Static core:RiskLevel.High}"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding RiskText}" FontSize="11" Foreground="#475569"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="1" x:Name="EmptyState" IsHitTestVisible="False" Background="White" Margin="0,40,0,0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◎" FontSize="46" Foreground="#CBD5E1" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="等待第一条行为记录" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="文件访问、网络通信和子进程会显示在这里" Foreground="#94A3B8" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="15,9"><TextBlock x:Name="HistoryHint" Text="界面保留最近 5,000 条；全部收到的记录持续保存到本地日志。" Style="{StaticResource Caption}"/></Border>
          </Grid>
            </TabItem>
            <TabItem x:Name="MonitoredProcessTab" Header="监控进程（0）">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="MonitoredProcessCount" Text="开始监控后显示目标及其全部被跟踪子进程" Style="{StaticResource Caption}" Margin="16,14,16,0"/>
                <Grid Grid.Row="1" Margin="16,10,16,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="MonitoredProcessSearch" Style="{StaticResource SearchBox}" Tag="搜索进程名、PID、父 PID 或路径" TextChanged="MonitoredProcessFilter_Changed"/>
                  <CheckBox x:Name="LiveProcessesOnly" Grid.Column="1" Content="只看存活进程" Margin="14,0,0,0" Checked="MonitoredProcessFilter_Changed" Unchecked="MonitoredProcessFilter_Changed"/>
                </Grid>
                <DataGrid x:Name="MonitoredProcessGrid" Grid.Row="2" RowHeight="32" ColumnHeaderHeight="32" SelectionChanged="MonitoredProcessGrid_SelectionChanged">
                  <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="10,7"/></Style></DataGrid.ColumnHeaderStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="76"/>
                    <DataGridTextColumn Header="进程名" Binding="{Binding Process.Name}" Width="170" ElementStyle="{StaticResource GridText}"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding Process.Id}" Width="75"/>
                    <DataGridTextColumn Header="父 PID" Binding="{Binding Process.ParentId}" Width="80"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="80"/>
                    <DataGridTextColumn Header="出网流量" Binding="{Binding OutboundTrafficText}" SortMemberPath="OutboundBytes" Width="100">
                      <DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="10,7"/><Setter Property="ToolTip" Value="自开始监控累计发送到公网的 TCP/UDP 字节，仅统计本进程；不含接收、本机和局域网通信。"/></Style></DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="启动时间" Binding="{Binding Process.StartTimeText}" SortMemberPath="Process.StartTimeUtcTicks" Width="158"/>
                    <DataGridTextColumn Header="程序路径" Binding="{Binding PathText}" Width="*" MinWidth="150" ElementStyle="{StaticResource GridText}"/>
                  </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="15,9">
                  <TextBlock Text="包含没有行为记录的已跟踪进程；新进程自动加入，退出后保留最后状态。" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </Border>
              </Grid>
            </TabItem>
            <TabItem x:Name="ReviewTab" Header="需要复核（0）">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="16,14,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="ReviewSearch" Style="{StaticResource SearchBox}" Tag="搜索复核记录的进程、路径、规则或原因" TextChanged="ReviewSearch_Changed"/>
                  <Button x:Name="ExportReviewButton" Grid.Column="1" Content="导出复核日志" Margin="12,0,0,0" IsEnabled="False" Click="ExportReview_Click"/>
                </Grid>
                <TextBlock x:Name="ReviewCount" Grid.Row="1" Text="本会话独立保留 0 条 · 当前显示 0 条" Style="{StaticResource Caption}" Margin="16,9,16,12"/>
                <DataGrid x:Name="ReviewGrid" Grid.Row="2" RowHeight="32" ColumnHeaderHeight="32" SelectionChanged="ReviewGrid_SelectionChanged">
                  <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="10,7"/></Style></DataGrid.ColumnHeaderStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="112"/>
                    <DataGridTextColumn Header="进程 / PID" Binding="{Binding ProcessText}" Width="180" ElementStyle="{StaticResource GridText}"/>
                    <DataGridTextColumn Header="提示" Binding="{Binding RiskText}" Width="80"/>
                    <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="92"/>
                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*" MinWidth="140" ElementStyle="{StaticResource GridText}"/>
                    <DataGridTextColumn Header="规则" Binding="{Binding RuleId}" Width="140" ElementStyle="{StaticResource GridText}"/>
                  </DataGrid.Columns>
                </DataGrid>
                <Grid x:Name="ReviewEmptyState" Grid.Row="2" IsHitTestVisible="False" Background="White" Margin="0,40,0,0">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="ReviewEmptyTitle" Text="尚无需要复核的事件" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="需复核和高关注记录会独立保留在这里" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
                </Grid>
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="15,9"><StackPanel>
                  <TextBlock Text="复核记录独立保留；普通事件滚动不会清除。行为线索需要结合程序用途判断。" Style="{StaticResource Caption}"/>
                  <TextBlock x:Name="ReviewLogPath" Text="开始新监控后，复核记录会自动保存到独立日志。" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,5,0,0"/>
                </StackPanel></Border>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="17,13" Margin="0,14,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="DetailTitle" Text="事件证据" FontWeight="SemiBold" FontSize="14"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"><TextBox x:Name="DetailText" Text="选择一条记录，查看完整目标、命令行和风险触发原因。&#10;风险提示需要结合程序用途判断，不能作为恶意软件结论。" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#64748B" Padding="0"/></ScrollViewer></Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="22,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="就绪 · 开始监控时会请求管理员权限" VerticalAlignment="Center" Foreground="#64748B" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="打开日志目录 ↗" Padding="4,4" BorderBrush="Transparent" Foreground="#2563EB" Click="OpenLogs_Click"/></Grid></Border>
  </Grid>
</UserControl>
