<Window x:Class="ProcessSentinel.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 行为哨兵" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        Background="#F4F7FB" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/MonitorStyles.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="保存后生效，下次启动自动使用这些默认选项。" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
      <StackPanel>
        <TextBlock Text="监控范围" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <CheckBox x:Name="ProgramTreeOption" Content="默认监控所属程序的完整进程树"/>
        <TextBlock Text="包含相关父进程、兄弟及子孙进程。关闭后默认只监控所选 PID。此项应用于新会话，已有会话保持原范围。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
        <TextBlock Text="行为记录" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <CheckBox x:Name="RiskOnlyOption" Content="默认只看风险提示"/>
        <TextBlock Text="保存后同步切换当前筛选，仅显示“需复核”和“高关注”记录。全部事件仍会采集并保存到日志。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
        <TextBlock Text="日志目录" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="LogDirectoryText" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="BrowseLogs_Click"/>
        </Grid>
        <Button Content="恢复默认目录" HorizontalAlignment="Left" Padding="0,5" BorderBrush="Transparent" Foreground="{StaticResource Accent}" Margin="0,6,0,0" Click="ResetLogs_Click"/>
        <TextBlock Text="新会话保存到此目录；已有会话继续写入原位置，历史日志保留原位置。保存前会检查目录是否可写。" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="2" Text="主窗口中的勾选可临时调整；在这里保存才会更新默认设置。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,18"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" MinWidth="82"/>
      <Button Content="保存" IsDefault="True" MinWidth="82" Margin="10,0,0,0" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
